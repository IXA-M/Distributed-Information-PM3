{
  "title": "Distributed Information Services",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests",
      "targets": [{ "expr": "sum(service_http_requests_total)" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "HTTP Error Rate",
      "targets": [{ "expr": "avg(service_http_error_rate)" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [{ "expr": "service_http_request_latency_ms{quantile=\"0.95\"}" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    }
  ]
}
