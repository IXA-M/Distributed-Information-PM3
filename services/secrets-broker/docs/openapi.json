{
    "openapi":  "3.0.3",
    "info":  {
                 "title":  "Secrets Broker API",
                 "version":  "1.0.0",
                 "description":  "Pure REST service for issuing secrets securely without publishing secret events to Kafka."
             },
    "servers":  [
                    {
                        "url":  "http://localhost:3001"
                    }
                ],
    "paths":  {
                  "/health":  {
                                  "get":  {
                                              "summary":  "Liveness probe",
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "Service is alive"
                                                                        }
                                                            }
                                          }
                              },
                  "/ready":  {
                                 "get":  {
                                             "summary":  "Readiness probe",
                                             "responses":  {
                                                               "200":  {
                                                                           "description":  "Service is ready"
                                                                       },
                                                               "503":  {
                                                                           "description":  "Service is not ready"
                                                                       }
                                                           }
                                         }
                             },
                  "/secrets/issue":  {
                                         "post":  {
                                                      "summary":  "Issue a secret for another service",
                                                      "requestBody":  {
                                                                          "required":  true,
                                                                          "content":  {
                                                                                          "application/json":  {
                                                                                                                   "schema":  {
                                                                                                                                  "type":  "object",
                                                                                                                                  "required":  [
                                                                                                                                                   "service"
                                                                                                                                               ],
                                                                                                                                  "properties":  {
                                                                                                                                                     "service":  {
                                                                                                                                                                     "type":  "string"
                                                                                                                                                                 },
                                                                                                                                                     "expiresInSeconds":  {
                                                                                                                                                                              "type":  "integer",
                                                                                                                                                                              "minimum":  1
                                                                                                                                                                          },
                                                                                                                                                     "scopes":  {
                                                                                                                                                                    "type":  "array",
                                                                                                                                                                    "items":  {
                                                                                                                                                                                  "type":  "string"
                                                                                                                                                                              }
                                                                                                                                                                }
                                                                                                                                                 }
                                                                                                                              }
                                                                                                               }
                                                                                      }
                                                                      },
                                                      "responses":  {
                                                                        "201":  {
                                                                                    "description":  "Secret issued"
                                                                                },
                                                                        "400":  {
                                                                                    "description":  "Validation error"
                                                                                }
                                                                    }
                                                  }
                                     },
                  "/docs/openapi.json":  {
                                             "get":  {
                                                         "summary":  "OpenAPI document",
                                                         "responses":  {
                                                                           "200":  {
                                                                                       "description":  "OpenAPI JSON"
                                                                                   }
                                                                       }
                                                     }
                                         },
                  "/docs":  {
                                "get":  {
                                            "summary":  "Swagger UI",
                                            "responses":  {
                                                              "200":  {
                                                                          "description":  "Swagger UI HTML"
                                                                      },
                                                              "302":  {
                                                                          "description":  "Redirects to Swagger UI assets"
                                                                      }
                                                          }
                                        }
                            },
                  "/api-docs":  {
                                    "get":  {
                                                "summary":  "Swagger UI assets",
                                                "responses":  {
                                                                  "200":  {
                                                                              "description":  "Swagger UI assets"
                                                                          }
                                                              }
                                            }
                                },
                  "/metrics":  {
                                   "get":  {
                                               "summary":  "Prometheus metrics",
                                               "responses":  {
                                                                 "200":  {
                                                                             "description":  "Prometheus metrics in text format"
                                                                         }
                                                             }
                                           }
                               }
              }
}
