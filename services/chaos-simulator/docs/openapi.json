{
    "openapi":  "3.0.3",
    "info":  {
                 "title":  "Chaos Simulator API",
                 "version":  "1.0.0",
                 "description":  "Hybrid REST + Kafka service that stores chaos rules and publishes chaos.rule.activated after REST success."
             },
    "servers":  [
                    {
                        "url":  "http://localhost:3002"
                    }
                ],
    "paths":  {
                  "/health":  {
                                  "get":  {
                                              "summary":  "Liveness probe",
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "Service is alive"
                                                                        }
                                                            }
                                          }
                              },
                  "/ready":  {
                                 "get":  {
                                             "summary":  "Readiness probe",
                                             "responses":  {
                                                               "200":  {
                                                                           "description":  "Service is ready"
                                                                       },
                                                               "503":  {
                                                                           "description":  "Service is not ready"
                                                                       }
                                                           }
                                         }
                             },
                  "/chaos/latency":  {
                                         "post":  {
                                                      "summary":  "Configure a latency chaos rule",
                                                      "requestBody":  {
                                                                          "required":  true,
                                                                          "content":  {
                                                                                          "application/json":  {
                                                                                                                   "schema":  {
                                                                                                                                  "type":  "object",
                                                                                                                                  "required":  [
                                                                                                                                                   "service",
                                                                                                                                                   "value"
                                                                                                                                               ],
                                                                                                                                  "properties":  {
                                                                                                                                                     "service":  {
                                                                                                                                                                     "type":  "string"
                                                                                                                                                                 },
                                                                                                                                                     "value":  {
                                                                                                                                                                   "type":  "object",
                                                                                                                                                                   "properties":  {
                                                                                                                                                                                      "delayMs":  {
                                                                                                                                                                                                      "type":  "integer",
                                                                                                                                                                                                      "minimum":  0
                                                                                                                                                                                                  }
                                                                                                                                                                                  }
                                                                                                                                                               },
                                                                                                                                                     "enabled":  {
                                                                                                                                                                     "type":  "boolean"
                                                                                                                                                                 }
                                                                                                                                                 }
                                                                                                                              }
                                                                                                               }
                                                                                      }
                                                                      },
                                                      "responses":  {
                                                                        "201":  {
                                                                                    "description":  "Rule stored"
                                                                                }
                                                                    }
                                                  }
                                     },
                  "/chaos/error-rate":  {
                                            "post":  {
                                                         "summary":  "Configure an error-rate chaos rule",
                                                         "requestBody":  {
                                                                             "required":  true,
                                                                             "content":  {
                                                                                             "application/json":  {
                                                                                                                      "schema":  {
                                                                                                                                     "type":  "object",
                                                                                                                                     "required":  [
                                                                                                                                                      "service",
                                                                                                                                                      "value"
                                                                                                                                                  ],
                                                                                                                                     "properties":  {
                                                                                                                                                        "service":  {
                                                                                                                                                                        "type":  "string"
                                                                                                                                                                    },
                                                                                                                                                        "value":  {
                                                                                                                                                                      "type":  "object",
                                                                                                                                                                      "properties":  {
                                                                                                                                                                                         "percentage":  {
                                                                                                                                                                                                            "type":  "number",
                                                                                                                                                                                                            "minimum":  0,
                                                                                                                                                                                                            "maximum":  100
                                                                                                                                                                                                        }
                                                                                                                                                                                     }
                                                                                                                                                                  },
                                                                                                                                                        "enabled":  {
                                                                                                                                                                        "type":  "boolean"
                                                                                                                                                                    }
                                                                                                                                                    }
                                                                                                                                 }
                                                                                                                  }
                                                                                         }
                                                                         },
                                                         "responses":  {
                                                                           "201":  {
                                                                                       "description":  "Rule stored"
                                                                                   }
                                                                       }
                                                     }
                                        },
                  "/docs/openapi.json":  {
                                             "get":  {
                                                         "summary":  "OpenAPI document",
                                                         "responses":  {
                                                                           "200":  {
                                                                                       "description":  "OpenAPI JSON"
                                                                                   }
                                                                       }
                                                     }
                                         },
                  "/docs":  {
                                "get":  {
                                            "summary":  "Swagger UI",
                                            "responses":  {
                                                              "200":  {
                                                                          "description":  "Swagger UI HTML"
                                                                      },
                                                              "302":  {
                                                                          "description":  "Redirects to Swagger UI assets"
                                                                      }
                                                          }
                                        }
                            },
                  "/api-docs":  {
                                    "get":  {
                                                "summary":  "Swagger UI assets",
                                                "responses":  {
                                                                  "200":  {
                                                                              "description":  "Swagger UI assets"
                                                                          }
                                                              }
                                            }
                                },
                  "/metrics":  {
                                   "get":  {
                                               "summary":  "Prometheus metrics",
                                               "responses":  {
                                                                 "200":  {
                                                                             "description":  "Prometheus metrics in text format"
                                                                         }
                                                             }
                                           }
                               }
              }
}
