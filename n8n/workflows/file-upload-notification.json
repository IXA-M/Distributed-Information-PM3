{
  "name": "File Upload Notification Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "webhookId": "upload-trigger"
    },
    {
      "parameters": {
        "url": "http://audit-log-service.cse474-prod.svc.cluster.local:3025/audit",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "actor",
              "value": "={{ $json.actor }}"
            },
            {
              "name": "action",
              "value": "={{ $json.action }}"
            },
              "name": "entity",
              "value": "={{ $json.entity }}"
            }
          ]
        },
        "options": {}
      },
      "id": "audit-call",
      "name": "Call Audit Log",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://central-logging-service.cse474-prod.svc.cluster.local:3026/logs",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "service",
              "value": "n8n-workflow"
            },
            {
              "name": "level",
              "value": "info"
            },
            {
              "name": "message",
              "value": "File uploaded: {{ $json.entity }}"
            }
          ]
        },
        "options": {}
      },
      "id": "log-call",
      "name": "Call Central Logging",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 450]
    },
    {
      "parameters": {
        "url": "https://webhook.site/your-mock-endpoint",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "File uploaded by {{ $json.actor }}"
            }
          ]
        }
      },
      "id": "notify",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 600]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Audit Log",
            "type": "main",
            "index": 0
          },
          {
            "node": "Call Central Logging",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
